list navigation-bar (
    name: Navigation Bar
)

list navigation-menu (
    name: Navigation Menu

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry invoices (
        label: Invoices
        icon {
            imageIconCssClasses: fa-file-text-o
        }
