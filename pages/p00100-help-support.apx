page 100 (
    name: "Help & Support"
    alias: HELP-SUPPORT
    title: "Help & Support - Kovaion Finance"
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }

    region help-main (
        name: "Help & Support"
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="padding: 24px; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <h2 style="font-size: 20px; font-weight: 700; color: #0f172a; margin-top: 0;">Help &amp; Support</h2>
                    <p style="color: #64748b; font-size: 14px;">Documentation, FAQ, user manuals, and technical assistance for Kovaion Enterprise Suite.</p>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)
