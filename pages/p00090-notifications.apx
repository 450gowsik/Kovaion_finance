page 90 (
    name: Notifications
    alias: NOTIFICATIONS
    title: "Notifications - Kovaion Finance"
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }

    region notifications-main (
        name: Notifications
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="padding: 24px; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <h2 style="font-size: 20px; font-weight: 700; color: #0f172a; margin-top: 0;">System Notifications &amp; Alerts</h2>
                    <p style="color: #64748b; font-size: 14px;">Review system alerts, invoice overdue reminders, and payment settlement notifications.</p>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)
