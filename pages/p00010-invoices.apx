                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
                                11.4% <span class="period">from last month</span>
                            </div>
                            <svg class="knk-card-wave" viewBox="0 0 100 40" fill="none">
                                <path d="M0 20 Q 25 5, 50 20 T 100 20 L 100 40 L 0 40 Z" fill="#10b981"/>
                            </svg>
                        </div>

                        <!-- Pending Invoices -->
                        <div class="knk-kpi-card">
                            <div class="knk-kpi-top">
                                <div>
                                    <div class="knk-kpi-label">Pending Invoices</div>
                                    <div class="knk-kpi-val">₹5,34,000</div>
                                </div>
                                <div class="knk-kpi-icon amber">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
