        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region invoices (
        name: "Invoices Register"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM KF_VW_INVOICE_SUMMARY
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 10010001
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
        )

    )

    button import-invoices (
        buttonName: IMPORT_INVOICES
        label: "Import Excel/CSV"
        layout {
            sequence: 5
            region: @invoices
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
            }
        }
    )

    button create-invoice (
        buttonName: CREATE_INVOICE
        label: "+ New Invoice"
        layout {
            sequence: 10
            region: @invoices
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
